{
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "title": "Option Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "reversible": {
          "title": "Reversible",
          "type": "boolean"
        },
        "switching_cost": {
          "$ref": "#/$defs/Quantity"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "option_id",
        "title",
        "description",
        "reversible",
        "switching_cost"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "epistemic_status": {
          "$ref": "#/$defs/EpistemicStatus"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "inference_basis": {
          "items": {
            "type": "string"
          },
          "title": "Inference Basis",
          "type": "array"
        },
        "confidence_level": {
          "$ref": "#/$defs/ConfidenceLevel",
          "default": "medium"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "expires_at_step": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At Step"
        }
      },
      "required": [
        "claim_id",
        "statement",
        "epistemic_status"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ConfidenceLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "DecisionCaseStatus": {
      "enum": [
        "DRAFT",
        "CONTEXT_BUILDING",
        "OPTIONS_READY",
        "DECISION_REQUIRED",
        "DECIDED",
        "ACTIONING",
        "VERIFIED",
        "CLOSED",
        "REOPENED"
      ],
      "title": "DecisionCaseStatus",
      "type": "string"
    },
    "DecisionType": {
      "enum": [
        "APPROVE",
        "APPROVE_WITH_GUARDRAILS",
        "RUN_REVERSIBLE_TRIAL",
        "COLLECT_MINIMUM_EVIDENCE",
        "DEFER_UNTIL_TRIGGER",
        "REJECT",
        "ESCALATE"
      ],
      "title": "DecisionType",
      "type": "string"
    },
    "DevelopmentTrack": {
      "additionalProperties": false,
      "properties": {
        "track_id": {
          "title": "Track Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/WorkItemStatus"
        },
        "next_milestone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Milestone Id"
        }
      },
      "required": [
        "track_id",
        "name",
        "status"
      ],
      "title": "DevelopmentTrack",
      "type": "object"
    },
    "EpistemicStatus": {
      "enum": [
        "fact",
        "inference",
        "assumption",
        "unknown"
      ],
      "title": "EpistemicStatus",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "evidence_type": {
          "title": "Evidence Type",
          "type": "string"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        },
        "available_at_step": {
          "minimum": 0,
          "title": "Available At Step",
          "type": "integer"
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "title",
        "evidence_type",
        "source_ref",
        "available_at_step"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Milestone": {
      "additionalProperties": false,
      "properties": {
        "milestone_id": {
          "title": "Milestone Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "planned_at_step": {
          "minimum": 0,
          "title": "Planned At Step",
          "type": "integer"
        }
      },
      "required": [
        "milestone_id",
        "title",
        "planned_at_step"
      ],
      "title": "Milestone",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/QuantityMode"
        },
        "unit": {
          "enum": [
            "mW",
            "mJ",
            "GB/s",
            "Mbps",
            "ms",
            "fps",
            "degC",
            "mm2",
            "ratio",
            "count",
            "person_day",
            "step"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "lower_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Bound"
        },
        "upper_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Bound"
        },
        "qualitative": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualitative"
        }
      },
      "required": [
        "mode",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "QuantityMode": {
      "enum": [
        "exact",
        "range",
        "qualitative",
        "unknown"
      ],
      "title": "QuantityMode",
      "type": "string"
    },
    "WorkItem": {
      "additionalProperties": false,
      "properties": {
        "work_item_id": {
          "title": "Work Item Id",
          "type": "string"
        },
        "track_id": {
          "title": "Track Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/WorkItemStatus"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "dependency_ids": {
          "items": {
            "type": "string"
          },
          "title": "Dependency Ids",
          "type": "array"
        },
        "blocker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocker"
        },
        "planned_at_step": {
          "minimum": 0,
          "title": "Planned At Step",
          "type": "integer"
        },
        "effective_at_step": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective At Step"
        }
      },
      "required": [
        "work_item_id",
        "track_id",
        "title",
        "status",
        "owner",
        "planned_at_step"
      ],
      "title": "WorkItem",
      "type": "object"
    },
    "WorkItemStatus": {
      "enum": [
        "PLANNED",
        "READY",
        "IN_PROGRESS",
        "BLOCKED",
        "DONE",
        "VERIFIED",
        "REWORK",
        "CANCELLED"
      ],
      "title": "WorkItemStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "observable-case.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "fixture_version": {
      "minimum": 1,
      "title": "Fixture Version",
      "type": "integer"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "title_ko": {
      "title": "Title Ko",
      "type": "string"
    },
    "current_step": {
      "minimum": 0,
      "title": "Current Step",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/DecisionCaseStatus"
    },
    "decision_question": {
      "title": "Decision Question",
      "type": "string"
    },
    "decision_deadline_milestone_id": {
      "title": "Decision Deadline Milestone Id",
      "type": "string"
    },
    "tracks": {
      "items": {
        "$ref": "#/$defs/DevelopmentTrack"
      },
      "title": "Tracks",
      "type": "array"
    },
    "work_items": {
      "items": {
        "$ref": "#/$defs/WorkItem"
      },
      "title": "Work Items",
      "type": "array"
    },
    "milestones": {
      "items": {
        "$ref": "#/$defs/Milestone"
      },
      "title": "Milestones",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "uncertainties": {
      "items": {
        "type": "string"
      },
      "title": "Uncertainties",
      "type": "array"
    },
    "alternatives": {
      "items": {
        "$ref": "#/$defs/Alternative"
      },
      "minItems": 2,
      "title": "Alternatives",
      "type": "array"
    },
    "required_role_ids": {
      "items": {
        "type": "string"
      },
      "title": "Required Role Ids",
      "type": "array"
    },
    "allowed_decision_types": {
      "items": {
        "$ref": "#/$defs/DecisionType"
      },
      "title": "Allowed Decision Types",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "fixture_version",
    "case_id",
    "title_ko",
    "current_step",
    "status",
    "decision_question",
    "decision_deadline_milestone_id",
    "tracks",
    "work_items",
    "milestones",
    "evidence",
    "claims",
    "uncertainties",
    "alternatives",
    "required_role_ids",
    "allowed_decision_types"
  ],
  "title": "ObservableCase",
  "type": "object"
}
