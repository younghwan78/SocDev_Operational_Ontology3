{
  "$defs": {
    "EnterpriseSourceRecord": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "enterprise-source-record.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_system": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Source System",
          "type": "string"
        },
        "source_tenant": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Source Tenant",
          "type": "string"
        },
        "source_object_type": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Source Object Type",
          "type": "string"
        },
        "external_id": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        },
        "external_version": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "External Version",
          "type": "string"
        },
        "effective_at": {
          "format": "date-time",
          "title": "Effective At",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source_updated_at": {
          "format": "date-time",
          "title": "Source Updated At",
          "type": "string"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "deletion_state": {
          "$ref": "#/$defs/SourceDeletionState"
        },
        "source_acl_ref": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Source Acl Ref",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/SourceDataClassification"
        },
        "payload": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Payload"
        }
      },
      "required": [
        "schema_version",
        "source_system",
        "source_tenant",
        "source_object_type",
        "external_id",
        "external_version",
        "effective_at",
        "observed_at",
        "source_updated_at",
        "ingested_at",
        "content_hash",
        "source_url",
        "deletion_state",
        "source_acl_ref",
        "classification",
        "payload"
      ],
      "title": "EnterpriseSourceRecord",
      "type": "object"
    },
    "EnterpriseSyncPage": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "enterprise-sync-page.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "page_index": {
          "minimum": 0,
          "title": "Page Index",
          "type": "integer"
        },
        "page_token": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Page Token",
          "type": "string"
        },
        "cursor_value": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Cursor Value",
          "type": "string"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/EnterpriseSourceRecord"
          },
          "minItems": 1,
          "title": "Records",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "page_index",
        "page_token",
        "cursor_value",
        "records"
      ],
      "title": "EnterpriseSyncPage",
      "type": "object"
    },
    "EnterpriseSyncPolicy": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "enterprise-sync-policy.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "policy_version": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "max_attempts_per_page": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Attempts Per Page",
          "type": "integer"
        },
        "retry_backoff_seconds": {
          "default": [
            1,
            2
          ],
          "items": {
            "type": "integer"
          },
          "maxItems": 9,
          "minItems": 1,
          "title": "Retry Backoff Seconds",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "policy_version"
      ],
      "title": "EnterpriseSyncPolicy",
      "type": "object"
    },
    "JsonValue": {},
    "SourceDataClassification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ],
      "title": "SourceDataClassification",
      "type": "string"
    },
    "SourceDeletionState": {
      "enum": [
        "ACTIVE",
        "DELETED",
        "RESTRICTED"
      ],
      "title": "SourceDeletionState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "enterprise-sync-fixture-corpus.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "corpus_version": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Corpus Version",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/EnterpriseSyncPolicy"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/EnterpriseSyncPage"
      },
      "minItems": 1,
      "title": "Pages",
      "type": "array"
    },
    "transient_failures_before_success": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Transient Failures Before Success",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "corpus_version",
    "policy",
    "pages"
  ],
  "title": "EnterpriseSyncFixtureCorpus",
  "type": "object"
}
