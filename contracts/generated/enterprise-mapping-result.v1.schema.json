{
  "$defs": {
    "EnterpriseSourceIdentity": {
      "additionalProperties": false,
      "properties": {
        "source_system": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Source System",
          "type": "string"
        },
        "source_tenant": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Source Tenant",
          "type": "string"
        },
        "source_object_type": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Source Object Type",
          "type": "string"
        },
        "external_id": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "External Id",
          "type": "string"
        }
      },
      "required": [
        "source_system",
        "source_tenant",
        "source_object_type",
        "external_id"
      ],
      "title": "EnterpriseSourceIdentity",
      "type": "object"
    },
    "JsonValue": {},
    "MappingDisposition": {
      "enum": [
        "ACCEPT",
        "QUARANTINE",
        "REJECT"
      ],
      "title": "MappingDisposition",
      "type": "string"
    },
    "MappingReasonCode": {
      "enum": [
        "MAPPED",
        "PROFILE_NOT_FOUND",
        "REQUIRED_FIELD_MISSING",
        "STATUS_UNMAPPED",
        "DUPLICATE_SOURCE_VERSION",
        "SOURCE_VERSION_CONFLICT",
        "OUT_OF_ORDER_SOURCE_UPDATE",
        "SOURCE_URL_CHANGED",
        "SOURCE_DELETED",
        "SOURCE_RESTRICTED",
        "LATE_ARRIVAL"
      ],
      "title": "MappingReasonCode",
      "type": "string"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "json_pointer": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Json Pointer",
          "type": "string"
        },
        "start_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Offset"
        },
        "end_offset": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Offset"
        }
      },
      "required": [
        "json_pointer"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "StructuredCandidateKind": {
      "enum": [
        "PROJECT",
        "WORK_ITEM",
        "ISSUE",
        "EVIDENCE",
        "EVENT"
      ],
      "title": "StructuredCandidateKind",
      "type": "string"
    },
    "StructuredMappingCandidate": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "enterprise-structured-candidate.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "candidate_kind": {
          "$ref": "#/$defs/StructuredCandidateKind"
        },
        "source_identity": {
          "$ref": "#/$defs/EnterpriseSourceIdentity"
        },
        "external_version": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "External Version",
          "type": "string"
        },
        "mapping_profile_id": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Mapping Profile Id",
          "type": "string"
        },
        "mapping_version": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Mapping Version",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "minProperties": 1,
          "title": "Values",
          "type": "object"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "minItems": 1,
          "title": "Source Spans",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "candidate_kind",
        "source_identity",
        "external_version",
        "mapping_profile_id",
        "mapping_version",
        "values",
        "source_spans"
      ],
      "title": "StructuredMappingCandidate",
      "type": "object"
    },
    "UnstructuredCandidateKind": {
      "enum": [
        "CLAIM",
        "RISK",
        "ASSUMPTION"
      ],
      "title": "UnstructuredCandidateKind",
      "type": "string"
    },
    "UnstructuredMappingCandidate": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "enterprise-unstructured-candidate.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "candidate_kind": {
          "$ref": "#/$defs/UnstructuredCandidateKind"
        },
        "source_identity": {
          "$ref": "#/$defs/EnterpriseSourceIdentity"
        },
        "external_version": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "External Version",
          "type": "string"
        },
        "mapping_profile_id": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Mapping Profile Id",
          "type": "string"
        },
        "mapping_version": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Mapping Version",
          "type": "string"
        },
        "extractor_version": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Extractor Version",
          "type": "string"
        },
        "review_status": {
          "const": "UNREVIEWED",
          "title": "Review Status",
          "type": "string"
        },
        "extractor_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extractor Confidence"
        },
        "text": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source_span": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "schema_version",
        "candidate_kind",
        "source_identity",
        "external_version",
        "mapping_profile_id",
        "mapping_version",
        "extractor_version",
        "review_status",
        "text",
        "source_span"
      ],
      "title": "UnstructuredMappingCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "enterprise-mapping-result.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_identity": {
      "$ref": "#/$defs/EnterpriseSourceIdentity"
    },
    "external_version": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "External Version",
      "type": "string"
    },
    "disposition": {
      "$ref": "#/$defs/MappingDisposition"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/MappingReasonCode"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "structured_candidates": {
      "items": {
        "$ref": "#/$defs/StructuredMappingCandidate"
      },
      "title": "Structured Candidates",
      "type": "array"
    },
    "unstructured_candidates": {
      "items": {
        "$ref": "#/$defs/UnstructuredMappingCandidate"
      },
      "title": "Unstructured Candidates",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "source_identity",
    "external_version",
    "disposition",
    "reason_codes"
  ],
  "title": "EnterpriseMappingResult",
  "type": "object"
}
