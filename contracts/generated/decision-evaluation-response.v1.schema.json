        },
        "accepted_risks_ko": {
          "items": {
            "type": "string"
          },
          "title": "Accepted Risks Ko",
          "type": "array"
        },
        "safeguards_ko": {
          "items": {
            "type": "string"
          },
          "title": "Safeguards Ko",
          "type": "array"
        },
        "rationale_ko": {
          "title": "Rationale Ko",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
