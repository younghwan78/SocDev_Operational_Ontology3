      "required": [
        "evidence_id",
        "title",
        "evidence_type",
        "status",
        "expected_at_step",
        "available_at_step",
        "source_ref",
        "limitations"
      ],
      "title": "ProjectEvidenceSituation",
      "type": "object"
    },
    "ProjectRiskSummary": {
      "additionalProperties": false,
      "properties": {
        "projection_schema_version": {
          "const": "project-risk-summary.v1",
