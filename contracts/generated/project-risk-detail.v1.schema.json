    "EvidenceStatus": {
      "enum": [
        "REQUESTED",
        "LATE",
        "RECEIVED"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "ProjectDecisionReferenceProjection": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "treated_risk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Treated Risk Ids",
          "type": "array"
        },
        "href": {
          "title": "Href",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "title",
        "status",
        "treated_risk_ids",
        "href"
      ],
      "title": "ProjectDecisionReferenceProjection",
      "type": "object"
    },
    "ProjectEvidenceSituation": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "evidence_type": {
          "title": "Evidence Type",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "expected_at_step": {
          "minimum": 0,
          "title": "Expected At Step",
          "type": "integer"
        },
        "available_at_step": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Available At Step"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Ref"
