    "reconstructed_at_step",
    "risk",
    "epistemic_status",
    "inference_basis",
    "downside",
    "blast_radius",
    "urgency",
    "reversibility",
    "source_issues",
    "source_events",
    "source_evidence",
    "cross_project_sources",
    "affected_objects",
    "decisions",
    "treatment_actions"
