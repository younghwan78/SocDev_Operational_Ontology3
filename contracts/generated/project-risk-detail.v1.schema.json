    "downside": {
      "title": "Downside",
      "type": "string"
    },
    "blast_radius": {
      "title": "Blast Radius",
      "type": "string"
    },
    "urgency": {
      "title": "Urgency",
      "type": "string"
    },
    "reversibility": {
      "title": "Reversibility",
      "type": "string"
