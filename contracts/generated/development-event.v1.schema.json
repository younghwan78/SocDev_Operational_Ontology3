{
  "$defs": {
    "DevelopmentActionDynamicState": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/DevelopmentActionStatus"
        },
        "due_at_step": {
          "minimum": 0,
          "title": "Due At Step",
          "type": "integer"
        },
        "blocker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocker"
        }
      },
      "required": [
        "status",
        "due_at_step"
      ],
      "title": "DevelopmentActionDynamicState",
      "type": "object"
    },
    "DevelopmentActionStateChange": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/DevelopmentActionDynamicState"
        },
        "after": {
          "$ref": "#/$defs/DevelopmentActionDynamicState"
        }
      },
      "required": [
        "action_id",
        "before",
        "after"
      ],
      "title": "DevelopmentActionStateChange",
      "type": "object"
    },
    "DevelopmentActionStatus": {
      "enum": [
        "PLANNED",
        "IN_PROGRESS",
        "BLOCKED",
        "COMPLETED",
        "CANCELLED"
      ],
      "title": "DevelopmentActionStatus",
      "type": "string"
    },
    "DevelopmentEventType": {
      "enum": [
        "WORK_PROGRESS",
        "BLOCKER_CHANGE",
        "PLAN_CHANGE",
        "DEPENDENCY_CHANGE",
        "EVIDENCE_CHANGE",
        "REWORK",
        "INTERFACE_CHANGE",
        "RESOURCE_CONFLICT",
        "PRIORITY_CHANGE",
        "DECISION_ACTION_PROGRESS"
      ],
      "title": "DevelopmentEventType",
      "type": "string"
    },
    "EvidenceDynamicState": {
      "additionalProperties": false,
      "properties": {
        "available_at_step": {
          "minimum": 0,
          "title": "Available At Step",
          "type": "integer"
        }
      },
      "required": [
        "available_at_step"
      ],
      "title": "EvidenceDynamicState",
      "type": "object"
    },
    "EvidenceStateChange": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/EvidenceDynamicState"
        },
        "after": {
          "$ref": "#/$defs/EvidenceDynamicState"
        }
      },
      "required": [
        "evidence_id",
        "before",
        "after"
      ],
      "title": "EvidenceStateChange",
      "type": "object"
    },
    "MilestoneDynamicState": {
      "additionalProperties": false,
      "properties": {
        "planned_at_step": {
          "minimum": 0,
          "title": "Planned At Step",
          "type": "integer"
        }
      },
      "required": [
        "planned_at_step"
      ],
      "title": "MilestoneDynamicState",
      "type": "object"
    },
    "MilestoneStateChange": {
      "additionalProperties": false,
      "properties": {
        "milestone_id": {
          "title": "Milestone Id",
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/MilestoneDynamicState"
        },
        "after": {
          "$ref": "#/$defs/MilestoneDynamicState"
        }
      },
      "required": [
        "milestone_id",
        "before",
        "after"
      ],
      "title": "MilestoneStateChange",
      "type": "object"
    },
    "WorkItemDynamicState": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/WorkItemStatus"
        },
        "blocker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocker"
        },
        "planned_at_step": {
          "minimum": 0,
          "title": "Planned At Step",
          "type": "integer"
        },
        "dependency_ids": {
          "items": {
            "type": "string"
          },
          "title": "Dependency Ids",
          "type": "array"
        }
      },
      "required": [
        "status",
        "planned_at_step"
      ],
      "title": "WorkItemDynamicState",
      "type": "object"
    },
    "WorkItemStateChange": {
      "additionalProperties": false,
      "properties": {
        "work_item_id": {
          "title": "Work Item Id",
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/WorkItemDynamicState"
        },
        "after": {
          "$ref": "#/$defs/WorkItemDynamicState"
        }
      },
      "required": [
        "work_item_id",
        "before",
        "after"
      ],
      "title": "WorkItemStateChange",
      "type": "object"
    },
    "WorkItemStatus": {
      "enum": [
        "PLANNED",
        "READY",
        "IN_PROGRESS",
        "BLOCKED",
        "DONE",
        "VERIFIED",
        "REWORK",
        "CANCELLED"
      ],
      "title": "WorkItemStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "development-event.v1",
      "default": "development-event.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/DevelopmentEventType"
    },
    "effective_at_step": {
      "minimum": 0,
      "title": "Effective At Step",
      "type": "integer"
    },
    "observed_at_step": {
      "minimum": 0,
      "title": "Observed At Step",
      "type": "integer"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "cause": {
      "minLength": 1,
      "title": "Cause",
      "type": "string"
    },
    "work_item_changes": {
      "items": {
        "$ref": "#/$defs/WorkItemStateChange"
      },
      "title": "Work Item Changes",
      "type": "array"
    },
    "milestone_changes": {
      "items": {
        "$ref": "#/$defs/MilestoneStateChange"
      },
      "title": "Milestone Changes",
      "type": "array"
    },
    "evidence_changes": {
      "items": {
        "$ref": "#/$defs/EvidenceStateChange"
      },
      "title": "Evidence Changes",
      "type": "array"
    },
    "action_changes": {
      "items": {
        "$ref": "#/$defs/DevelopmentActionStateChange"
      },
      "title": "Action Changes",
      "type": "array"
    },
    "impacted_milestone_ids": {
      "items": {
        "type": "string"
      },
      "title": "Impacted Milestone Ids",
      "type": "array"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "effective_at_step",
    "observed_at_step",
    "summary",
    "cause"
  ],
  "title": "DevelopmentEvent",
  "type": "object"
}
