    "EvidenceStatus": {
      "enum": [
        "REQUESTED",
        "LATE",
        "RECEIVED"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "MilestoneStatus": {
      "enum": [
        "PLANNED",
        "AT_RISK",
        "ACHIEVED"
      ],
