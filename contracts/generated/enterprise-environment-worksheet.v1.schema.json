{
  "$defs": {
    "HandoffCheckStatus": {
      "enum": [
        "VERIFIED_EXTERNALLY",
        "UNCONFIRMED_INTERNAL",
        "NOT_APPLICABLE",
        "NOT_EVALUATED"
      ],
      "title": "HandoffCheckStatus",
      "type": "string"
    },
    "HandoffValueOwnership": {
      "enum": [
        "EXTERNALLY_VERIFIED",
        "INTERNAL_REQUIRED"
      ],
      "title": "HandoffValueOwnership",
      "type": "string"
    },
    "HandoffWorksheetItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "topic": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "ownership": {
          "$ref": "#/$defs/HandoffValueOwnership"
        },
        "status": {
          "$ref": "#/$defs/HandoffCheckStatus"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Ref"
        },
        "must_not_commit_value": {
          "default": false,
          "title": "Must Not Commit Value",
          "type": "boolean"
        }
      },
      "required": [
        "item_id",
        "topic",
        "ownership",
        "status"
      ],
      "title": "HandoffWorksheetItem",
      "type": "object"
    },
    "HandoffWorksheetSection": {
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Section Id",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/HandoffWorksheetItem"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "section_id",
        "items"
      ],
      "title": "HandoffWorksheetSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "enterprise-environment-worksheet.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "worksheet_version": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Worksheet Version",
      "type": "string"
    },
    "company_data_included": {
      "const": false,
      "title": "Company Data Included",
      "type": "boolean"
    },
    "credential_value_included": {
      "const": false,
      "title": "Credential Value Included",
      "type": "boolean"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/HandoffWorksheetSection"
      },
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "worksheet_version",
    "company_data_included",
    "credential_value_included",
    "sections"
  ],
  "title": "EnterpriseEnvironmentWorksheet",
  "type": "object"
}
