      "default": null,
      "title": "Escalation Target"
    },
    "questions_to_resolve": {
      "items": {
        "type": "string"
      },
      "title": "Questions To Resolve",
      "type": "array"
    },
    "reopen_condition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reopen Condition"
    }
  },
  "required": [
    "action_type",
    "owner",
    "action",
    "due_at_step",
    "trigger",
    "verification",
    "fallback_action"
